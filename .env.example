# Option A: Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B: Google Cloud / Vertex AI, using your gcloud login (and Cloud credits) instead of a key.
# Run `gcloud auth application-default login` once, leave GEMINI_API_KEY empty, and uncomment:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

MODEL=gemini-3.8-live
VOICE=Kore
PERSONA_FILE=app/persona/receptionist.md
# Comma-separated modules whose @tool functions the agent can call
TOOL_MODULES=app.tools.hotel,app.tools.call
